<?xml version="1.0" encoding="utf-8"?>
<!--
  Profile publish: self-contained, single-file cho win-x64.
  Visual Studio: chuột phải project > Publish > chọn profile này.
  CLI: dotnet publish GameAssistantPro\GameAssistantPro.csproj -p:PublishProfile=win-x64
  Kết quả: 1 file GameAssistantPro.exe + vài DLL native (*_cor3.dll) -> giải nén chạy thẳng, không cần cài .NET.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>bin\Release\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
