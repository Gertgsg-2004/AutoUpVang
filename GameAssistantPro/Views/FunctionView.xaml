<UserControl x:Class="GameAssistantPro.Views.FunctionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== CHỨC NĂNG CHUNG ===== -->
            <GroupBox Header="Chức năng chung" Grid.Row="0" Grid.Column="0">
                <StackPanel>
                    <WrapPanel>
                        <CheckBox Content="Thoát khi đủ SM" IsChecked="{Binding Config.ExitWhenEnoughSm}"/>
                        <TextBlock Text="Mốc SM:" Margin="16,3,3,3"/>
                        <TextBox Width="140" Text="{Binding Config.TargetSm, UpdateSourceTrigger=PropertyChanged}"/>
                    </WrapPanel>

                    <WrapPanel>
                        <CheckBox Content="Về nhà KI khi &lt;" IsChecked="{Binding Config.DrawKiHouse}"/>
                        <TextBox Width="60" Text="{Binding Config.KiHousePercent, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="%" Margin="3"/>
                    </WrapPanel>

                    <WrapPanel>
                        <TextBlock Text="Delay Xmap (ms):" Margin="3"/>
                        <TextBox Width="70" Text="{Binding Config.DelayXmapMs, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Chết về sau (ms):" Margin="16,3,3,3"/>
                        <TextBox Width="70" Text="{Binding Config.DeathReturnMs, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Quay lại sau (ms):" Margin="16,3,3,3"/>
                        <TextBox Width="70" Text="{Binding Config.ReturnAfterMs, UpdateSourceTrigger=PropertyChanged}"/>
                    </WrapPanel>

                    <WrapPanel>
                        <CheckBox Content="Use Item" IsChecked="{Binding Config.UseItem}"/>
                        <CheckBox Content="GLT" Margin="16,3,3,3" IsChecked="{Binding Config.UseGlt}"/>
                        <CheckBox Content="Default" Margin="16,3,3,3" IsChecked="{Binding Config.UseDefault}"/>
                    </WrapPanel>

                    <WrapPanel>
                        <CheckBox Content="Mua khẩu trang" IsChecked="{Binding Config.BuyMask}"/>
                        <TextBlock Text="SL:" Margin="8,3,3,3"/>
                        <TextBox Width="60" Text="{Binding Config.MaskQty, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="Mua cỏ 4 lá" Margin="20,3,3,3" IsChecked="{Binding Config.BuyClover}"/>
                        <TextBlock Text="SL:" Margin="8,3,3,3"/>
                        <TextBox Width="60" Text="{Binding Config.CloverQty, UpdateSourceTrigger=PropertyChanged}"/>
                    </WrapPanel>

                    <WrapPanel>
                        <CheckBox Content="Tách / hợp nhất" IsChecked="{Binding Config.SplitMerge}"/>
                        <CheckBox Content="Đi theo" Margin="20,3,3,3" IsChecked="{Binding Config.Follow}"/>
                        <TextBox Width="120" Text="{Binding Config.FollowTarget, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Config.Follow}"/>
                        <CheckBox Content="Auto xin đậu" Margin="20,3,3,3" IsChecked="{Binding Config.AutoAskBeans}"/>
                        <CheckBox Content="Mua thỏi vàng" Margin="20,3,3,3" IsChecked="{Binding Config.BuyGoldIngot}"/>
                    </WrapPanel>

                    <WrapPanel>
                        <TextBlock Text="Thời gian ON:" Margin="3"/>
                        <TextBox Width="70" Text="{Binding Config.OnTimeStart, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="-" Margin="6,3"/>
                        <TextBox Width="70" Text="{Binding Config.OnTimeEnd, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(định dạng HH:mm)" Foreground="{StaticResource SubTextBrush}" Margin="8,3,3,3"/>
                    </WrapPanel>

                    <WrapPanel>
                        <CheckBox Content="Tự khởi động lại khi lỗi" IsChecked="{Binding Config.AutoRestart}"/>
                        <TextBlock Text="Chờ (s):" Margin="16,3,3,3"/>
                        <TextBox Width="60" Text="{Binding Config.RestartDelaySeconds, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Số lần (0=∞):" Margin="16,3,3,3"/>
                        <TextBox Width="60" Text="{Binding Config.MaxRestarts, UpdateSourceTrigger=PropertyChanged}"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- ===== VÉ VÀNG / NRJ ===== -->
            <GroupBox Header="Vé vàng / NRJ" Grid.Row="0" Grid.Column="1">
                <StackPanel>
                    <CheckBox Content="Bật vé vàng" IsChecked="{Binding Config.GoldTicket.Enabled}"/>
                    <WrapPanel>
                        <TextBlock Text="Map vào:" Margin="3"/>
                        <ComboBox Width="90" ItemsSource="{Binding EnterMapOptions}"
                                  SelectedItem="{Binding Config.GoldTicket.EnterMap}"/>
                    </WrapPanel>
                    <CheckBox Content="Năng lượng E10" IsChecked="{Binding Config.GoldTicket.EnergyE10}"/>
                    <CheckBox Content="Mua vé vàng" IsChecked="{Binding Config.GoldTicket.BuyGoldTicket}"/>
                    <CheckBox Content="Thỏi vàng NRJ" IsChecked="{Binding Config.GoldTicket.GoldBarNrj}"/>
                    <WrapPanel>
                        <TextBlock Text="Mua khi vàng &gt;=" Margin="3"/>
                        <TextBox Width="160" Text="{Binding Config.GoldTicket.BuyWhenGoldGte, UpdateSourceTrigger=PropertyChanged}"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- ===== MUA BÙA ===== -->
            <GroupBox Header="Kích hoạt mua bùa" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                <StackPanel>
                    <CheckBox Content="Kích hoạt mua bùa" IsChecked="{Binding Config.Buff.Enabled}"/>
                    <WrapPanel>
                        <TextBlock Text="Thời hạn:" Margin="3" FontWeight="SemiBold"/>
                        <RadioButton GroupName="Dur" Content="1 giờ"
                                     IsChecked="{Binding Config.Buff.Duration, Converter={StaticResource EnumBool}, ConverterParameter=OneHour}"/>
                        <RadioButton GroupName="Dur" Content="8 giờ"
                                     IsChecked="{Binding Config.Buff.Duration, Converter={StaticResource EnumBool}, ConverterParameter=EightHours}"/>
                        <RadioButton GroupName="Dur" Content="1 tháng"
                                     IsChecked="{Binding Config.Buff.Duration, Converter={StaticResource EnumBool}, ConverterParameter=OneMonth}"/>
                        <TextBlock Text="     Chế độ:" Margin="3" FontWeight="SemiBold"/>
                        <RadioButton GroupName="BuyMode" Content="Hết mua tiếp"
                                     IsChecked="{Binding Config.Buff.BuyMode, Converter={StaticResource EnumBool}, ConverterParameter=KeepBuying}"/>
                        <RadioButton GroupName="BuyMode" Content="1 lần"
                                     IsChecked="{Binding Config.Buff.BuyMode, Converter={StaticResource EnumBool}, ConverterParameter=Once}"/>
                    </WrapPanel>

                    <DataGrid Height="300" ItemsSource="{Binding Config.Buff.Buffs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Loại bùa" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Mua"
                                                    Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>
