<Window x:Class="GameAssistantPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GameAssistantPro.Views"
        Title="Game Assistant Pro" Height="780" Width="1200"
        MinHeight="600" MinWidth="980"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!-- Header / toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🐉 Game Assistant Pro" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentTextBrush}"/>
                    <TextBlock Text="v1.0" Margin="10,0,0,0" Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="▶  Chạy tất cả" Command="{Binding StartAllCommand}"/>
                    <Button Content="⏹  Dừng tất cả" Command="{Binding StopAllCommand}"/>
                    <Button Content="💾  Lưu cấu hình" Command="{Binding SaveConfigCommand}"/>
                    <Button Content="↻  Tải lại" Command="{Binding ReloadConfigCommand}"
                            Background="{StaticResource HeaderBackground}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBackground}" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SubTextBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding ConfigPath}" Foreground="{StaticResource SubTextBrush}"
                           FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Background="Transparent" BorderThickness="0" Padding="0,8,0,0" Margin="8">
            <TabItem Header="Tài khoản">
                <views:AccountView DataContext="{Binding Account}"/>
            </TabItem>
            <TabItem Header="Giao dịch">
                <views:TradeView DataContext="{Binding Trade}"/>
            </TabItem>
            <TabItem Header="Train">
                <views:TrainView DataContext="{Binding Train}"/>
            </TabItem>
            <TabItem Header="Chức năng">
                <views:FunctionView DataContext="{Binding Function}"/>
            </TabItem>
            <TabItem Header="Nhật ký">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Trạng thái tài khoản" Grid.Row="0">
                        <DataGrid ItemsSource="{Binding Runners}" Height="150" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tài khoản" Binding="{Binding Account.Username}" Width="*"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="140"/>
                                <DataGridTextColumn Header="SM" Binding="{Binding Account.RuntimePower, StringFormat=N0}" Width="160"/>
                                <DataGridTemplateColumn Header="Điều khiển" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="▶" ToolTip="Chạy tài khoản này" Padding="10,2" Margin="2"
                                                        Command="{Binding DataContext.StartAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Account}"/>
                                                <Button Content="⏹" ToolTip="Dừng tài khoản này" Padding="10,2" Margin="2"
                                                        Background="{StaticResource HeaderBackground}"
                                                        Command="{Binding DataContext.StopAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Account}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6,4">
                        <TextBlock Text="Nhật ký hoạt động" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold"/>
                        <Button Content="🧹  Xóa log" Margin="16,0,0,0" Command="{Binding ClearLogsCommand}"
                                Background="{StaticResource HeaderBackground}"/>
                    </StackPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Logs}" Margin="6"
                             Background="{StaticResource InputBackground}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                             FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
