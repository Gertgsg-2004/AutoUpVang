<UserControl x:Class="GameAssistantPro.Views.TradeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="6">

        <!-- Cấu hình chung giao dịch -->
        <GroupBox Header="Giao dịch chuyển đồ (set / map / khu dùng chung)" DockPanel.Dock="Top">
            <WrapPanel Orientation="Horizontal">
                <CheckBox Content="Kích hoạt bản đồ giao dịch" IsChecked="{Binding Config.Enabled}"
                          VerticalAlignment="Center" Margin="3,3,20,3"/>
                <TextBlock Text="Tài khoản:" Margin="3"/>
                <ComboBox Width="180" ItemsSource="{Binding Accounts}"
                          DisplayMemberPath="Username" SelectedValuePath="Username"
                          SelectedValue="{Binding Config.AccountName}"/>
                <TextBlock Text="Map:" Margin="16,3,3,3"/>
                <TextBox Width="80" Text="{Binding Config.Map, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Khu:" Margin="16,3,3,3"/>
                <TextBox Width="80" Text="{Binding Config.Zone, UpdateSourceTrigger=PropertyChanged}"/>
            </WrapPanel>
        </GroupBox>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bảng map giao dịch -->
            <GroupBox Header="Bảng map giao dịch" Grid.Column="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="➕  Thêm dòng" Command="{Binding AddMapEntryCommand}"/>
                        <Button Content="🗑  Xóa dòng" Command="{Binding DeleteMapEntryCommand}"
                                Background="{StaticResource HeaderBackground}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Config.MapEntries}" SelectedItem="{Binding SelectedMapEntry}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ID map" Binding="{Binding MapId}" Width="*"/>
                            <DataGridTextColumn Header="ID normal" Binding="{Binding NormalId}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <!-- Nhập theo Set -->
            <GroupBox Header="Nhập theo Set" Grid.Column="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ID đồ sao"/>
                        <TextBox   Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SetStarItemId, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ID đồ thường"/>
                        <TextBox   Grid.Row="1" Grid.Column="1"
                                   Text="{Binding SetNormalItemId, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="➕  Thêm / cập nhật set" Command="{Binding AddOrUpdateSetCommand}"/>
                            <Button Content="🗑  Xóa set" Command="{Binding DeleteSetCommand}"
                                    Background="{StaticResource HeaderBackground}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid ItemsSource="{Binding Config.Sets}" SelectedItem="{Binding SelectedSet}" Margin="3,8,3,3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ID đồ sao" Binding="{Binding StarItemId}" Width="*"/>
                            <DataGridTextColumn Header="ID đồ thường" Binding="{Binding NormalItemId}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
